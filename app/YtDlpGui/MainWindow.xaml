<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YtDlpGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YtDlpGui.Models">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 自定义标题栏 -->
    <Grid x:Name="AppTitleBar" Height="44" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
        <FontIcon Glyph="&#xE8B7;" FontSize="15" />
        <TextBlock x:Name="AppTitleText" Text="视频下载器 · yt-dlp" VerticalAlignment="Center"
                   FontSize="12" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Padding="16,2,16,10" RowSpacing="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 输入卡片 -->
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBox x:Name="UrlBox"
                   Header="视频链接（每行一个；为空时自动读剪贴板）"
                   PlaceholderText="粘贴任意视频网站链接，回车或点「开始下载」…"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="68" MaxHeight="140"
                   Text="{x:Bind Vm.UrlInput, Mode=TwoWay}"
                   KeyDown="OnUrlBoxKeyDown" />

          <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="CookieCombo" Header="Cookies 来源" MinWidth="190"
                      SelectionChanged="OnCookieSelectionChanged" />
            <ComboBox x:Name="QualityCombo" Grid.Column="1" Header="画质" MinWidth="130"
                      SelectionChanged="OnQualitySelectionChanged" />
            <ComboBox x:Name="ContainerCombo" Grid.Column="2" Header="格式" MinWidth="120"
                      SelectionChanged="OnContainerSelectionChanged" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom"
                        Margin="4,0,0,8">
              <CheckBox x:Name="PlaylistBox" Content="整个列表"
                        Checked="OnPlaylistChecked" Unchecked="OnPlaylistUnchecked" />
              <CheckBox x:Name="MetaBox" Content="元数据"
                        Checked="OnMetaChecked" Unchecked="OnMetaUnchecked" />
            </StackPanel>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <Button x:Name="PasteBtn" Content="粘贴" Click="OnPasteClick" />
              <Button x:Name="DownloadBtn" Content="开始下载" Style="{StaticResource AccentButtonStyle}"
                      MinWidth="116" Click="OnDownloadClick" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" />
            <TextBlock x:Name="DirText" Grid.Column="1" VerticalAlignment="Center"
                       Text="{x:Bind Vm.OutputDir, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="DirBtn" Grid.Column="2" Content="更改目录" Click="OnPickDirClick" />
            <Button x:Name="OpenDirBtn" Grid.Column="3" Content="打开目录" Click="OnOpenDirClick" />
            <Button x:Name="SettingsBtn" Grid.Column="4" Content="设置">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Width="310" Spacing="14">
                    <ToggleSwitch x:Name="AutoDlSwitch" Header="自动下载缺失组件 (yt-dlp / ffmpeg)"
                                  Toggled="OnAutoDlToggled" />
                    <ComboBox x:Name="MirrorCombo" Header="GitHub 下载源" MinWidth="240"
                              SelectionChanged="OnMirrorSelectionChanged">
                      <ComboBoxItem Content="GitHub 直连" />
                      <ComboBoxItem Content="ghproxy.cn 镜像" />
                      <ComboBoxItem Content="gh-proxy.com 镜像" />
                    </ComboBox>
                    <ComboBox x:Name="ConcCombo" Header="同时下载任务数" MinWidth="240"
                              SelectionChanged="OnConcSelectionChanged">
                      <ComboBoxItem Content="1" />
                      <ComboBoxItem Content="2" />
                      <ComboBoxItem Content="3" />
                      <ComboBoxItem Content="4" />
                    </ComboBox>
                    <TextBlock Text="提示：Chrome 127+ 的 Cookies 有应用绑定加密，若解密失败请先完全退出 Chrome，或改用 Edge / Firefox。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <!-- 任务列表 -->
      <ListView x:Name="TaskList" Grid.Row="1" ItemsSource="{x:Bind Vm.Tasks}" SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="models:DownloadTask">
            <Grid ColumnSpacing="12" Padding="6,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <FontIcon Glyph="{x:Bind PhaseGlyph, Mode=OneWay}" FontSize="18"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Maximum="100" Value="{x:Bind ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" />
                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="取消" Click="OnCancelClick"
                        Visibility="{x:Bind CancelButtonVisibility, Mode=OneWay}" />
                <Button Content="打开" Click="OnOpenClick" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- 日志 + 状态栏 -->
      <Grid Grid.Row="2" RowSpacing="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Expander Header="运行日志" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" Height="150"
                   TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Expander>

        <TextBlock Grid.Row="1" Text="{x:Bind Vm.ToolStatus, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
      </Grid>
    </Grid>
  </Grid>
</Window>
